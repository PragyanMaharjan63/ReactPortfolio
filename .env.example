# Copy to .env for local development:  cp .env.example .env
# .env is gitignored and is never copied into the Docker image.

# --- Server ---------------------------------------------------------------
NODE_ENV=production
# Port the Express server listens on *inside* the container.
PORT=3000
# Must be 0.0.0.0 in a container, or the port mapping cannot reach it.
HOSTNAME=0.0.0.0

# Canonical origin, used for canonical URLs and og:url in the injected metadata.
SITE_URL=https://maharjanpragyan.com.np

# --- Database (optional) --------------------------------------------------
# The site is fully functional without this. When unset, /api/projects serves
# the bundled project content generated from client/src/data/projects.ts.
# Setting it lets you edit project content in MongoDB without a redeploy.
#
# Local:    mongodb://127.0.0.1:27017/portfolio
# Compose:  mongodb://mongo:27017/portfolio
MONGODB_URI=

# --- Paths (optional) -----------------------------------------------------
# Absolute path to the built client. Auto-detected when unset.
CLIENT_DIR=
