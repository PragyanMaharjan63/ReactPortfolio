# Copy to .env.local for development. Never commit real passwords or tokens.
SITE_URL=https://maharjanpragyan.com.np

# Local development / self-hosted SQLite (ignored when Turso is configured).
DATABASE_PATH=./data/portfolio.sqlite

# Required for persistent SQLite edits on Vercel. Get both from Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required to enable /dashboard. There are no default credentials.
# Choose a unique password with 12–256 characters.
ADMIN_PASSWORD=
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
