# Copy to .env and fill in the value:
#
#   cp .env.example .env
#
# .env is gitignored. Only variables prefixed with VITE_ are exposed to the
# client, and Vite INLINES them into the JS bundle at build time — so this is
# build-time configuration, not a runtime secret. Anything put here is
# readable by anyone who loads the site. Never put a real secret in a VITE_
# variable.

# Formspree form ID used by src/components/contact.jsx.
# Found in your Formspree dashboard: the ID in https://formspree.io/f/<id>
# If this is left empty the site still works, but the contact form is
# disabled and tells visitors to use email instead.
VITE_FORMSPREE_ID=
