# Caddy config for the built Vite SPA.
#
# Serves the static bundle produced by `npm run build` on port 9866, which is
# non-privileged so the server can run as an unprivileged user.
{
	# No admin API and no automatic HTTPS: this container is a plain HTTP
	# origin, TLS is terminated in front of it.
	admin off
	auto_https off
	# Nothing to persist, so /config need not be writable at runtime.
	persist_config off
}

:9866 {
	root * /srv
	encode zstd gzip

	# Applied to every response.
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Health endpoint used by the image HEALTHCHECK and the Jenkins pipeline.
	handle /healthz {
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}

	# Vite emits content-hashed filenames here, so they can be cached forever.
	# A miss is a genuine 404, not an SPA route.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else falls back to index.html for client-side routing. The
	# entry document must always revalidate, or a deploy would not be picked
	# up until the browser cache expired.
	handle {
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
