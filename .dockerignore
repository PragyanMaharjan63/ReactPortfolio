# Dependencies — reinstalled in the image from the lockfile
node_modules
**/node_modules

# Build output — regenerated in the image
client/dist
server/dist
dist
.vite

# Version control and CI
.git
.gitignore
.gitattributes
.github
Jenkinsfile
Dockerfile
.dockerignore
compose.yaml
docker-compose.yml

# Local env — never baked into an image
.env
.env.*
!.env.example

# Editor / OS
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Logs and coverage
logs
*.log
npm-debug.log*
coverage
.nyc_output

# Docs
README.md

# Print sources — the GLBs are built from these and committed to
# client/public/models/, so the STLs are not needed in the image.
stlfiles

# Simulation sources. The firmware is compiled to client/public/sim/*.wasm and
# the .blend files to client/public/models/*.glb by scripts/sim/build.sh, and
# those outputs are committed — so the runtime image needs neither the
# toolchain nor these sources. scripts/sim itself must stay: its own Dockerfile
# COPYs build.sh from the build context.
scripts/blender
scripts/robotCode
